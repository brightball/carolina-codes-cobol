>>SOURCE FORMAT FREE
*> Thin HTTP shell: parse GET target, CALL shipped HANDLE-GET, write JSON.
IDENTIFICATION DIVISION.
PROGRAM-ID. CAROLINA-SERVER.

ENVIRONMENT DIVISION.
CONFIGURATION SECTION.
REPOSITORY.
    FUNCTION ALL INTRINSIC.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-PORT USAGE BINARY-LONG VALUE 0.
01 WS-LISTEN USAGE BINARY-LONG VALUE -1.
01 WS-CLIENT USAGE BINARY-LONG VALUE -1.
01 WS-CAP USAGE BINARY-LONG VALUE 8192.
01 WS-N USAGE BINARY-LONG VALUE 0.
01 WS-SENT USAGE BINARY-LONG VALUE 0.
01 REQ PIC X(8192).
01 METH PIC X(16).
01 TARGET PIC X(512).
01 REST PIC X(1024).
01 PATH PIC X(512).
01 QS PIC X(512).
01 YEAR-Q PIC X(16).
01 Q1 PIC X(128).
01 Q2 PIC X(128).
01 Q3 PIC X(128).
01 STATUS-CODE PIC 9(3).
01 BODY PIC X(131072).
01 RESP PIC X(132096).
01 RESP-LEN USAGE BINARY-LONG.
01 BODY-LEN USAGE BINARY-LONG.
01 HDR PIC X(256).
01 HDR-LEN USAGE BINARY-LONG.
01 REASON PIC X(16).
01 LEN-EDIT PIC Z(8)9.
01 LEN-TXT PIC X(16).
01 WS-I USAGE BINARY-LONG.
01 WS-CH PIC X.

PROCEDURE DIVISION.
    CALL "carolina_register"
    CALL "carolina_listen" USING WS-PORT WS-LISTEN
    IF WS-LISTEN < 0
        DISPLAY "cobol listen failed" UPON STDERR
        MOVE 1 TO RETURN-CODE
        STOP RUN
    END-IF
    PERFORM UNTIL 1 = 0
        MOVE -1 TO WS-CLIENT
        CALL "carolina_accept" USING WS-LISTEN WS-CLIENT
        IF WS-CLIENT >= 0
            PERFORM HANDLE-CLIENT
            CALL "carolina_close" USING WS-CLIENT
        END-IF
    END-PERFORM
    STOP RUN.

HANDLE-CLIENT.
    MOVE SPACES TO REQ PATH YEAR-Q BODY RESP
    MOVE 8192 TO WS-CAP
    MOVE 0 TO WS-N
    CALL "carolina_recv" USING WS-CLIENT REQ WS-CAP WS-N
    PERFORM PARSE-REQUEST
    CALL "HANDLE-GET" USING PATH YEAR-Q STATUS-CODE BODY
    PERFORM WRITE-RESPONSE.

PARSE-REQUEST.
    MOVE "/" TO PATH
    MOVE SPACES TO YEAR-Q METH TARGET REST QS Q1 Q2 Q3
    UNSTRING REQ DELIMITED BY SPACE INTO METH TARGET REST
        ON OVERFLOW CONTINUE
    END-UNSTRING
    IF TARGET = SPACES
        MOVE "/" TO TARGET
    END-IF
    UNSTRING TARGET DELIMITED BY "?" INTO PATH QS
        ON OVERFLOW CONTINUE
    END-UNSTRING
    IF PATH = SPACES
        MOVE "/" TO PATH
    END-IF
    IF QS NOT = SPACES
        UNSTRING QS DELIMITED BY "&" INTO Q1 Q2 Q3
            ON OVERFLOW CONTINUE
        END-UNSTRING
        PERFORM TAKE-YEAR
    END-IF.

TAKE-YEAR.
    IF Q1(1:5) = "year="
        MOVE FUNCTION TRIM(Q1(6:)) TO YEAR-Q
    END-IF
    IF Q2(1:5) = "year="
        MOVE FUNCTION TRIM(Q2(6:)) TO YEAR-Q
    END-IF
    IF Q3(1:5) = "year="
        MOVE FUNCTION TRIM(Q3(6:)) TO YEAR-Q
    END-IF.

WRITE-RESPONSE.
    MOVE FUNCTION LENGTH(FUNCTION TRIM(BODY)) TO BODY-LEN
    IF STATUS-CODE = 404
        MOVE "Not Found" TO REASON
    ELSE
        MOVE "OK" TO REASON
    END-IF
    MOVE BODY-LEN TO LEN-EDIT
    MOVE FUNCTION TRIM(LEN-EDIT) TO LEN-TXT
    MOVE SPACES TO HDR
    STRING
        "HTTP/1.1 " DELIMITED BY SIZE
        STATUS-CODE DELIMITED BY SIZE
        " " DELIMITED BY SIZE
        FUNCTION TRIM(REASON) DELIMITED BY SIZE
        X"0D0A" DELIMITED BY SIZE
        "Content-Type: application/json" DELIMITED BY SIZE
        X"0D0A" DELIMITED BY SIZE
        "Content-Length: " DELIMITED BY SIZE
        FUNCTION TRIM(LEN-TXT) DELIMITED BY SIZE
        X"0D0A" DELIMITED BY SIZE
        "Connection: close" DELIMITED BY SIZE
        X"0D0A" DELIMITED BY SIZE
        X"0D0A" DELIMITED BY SIZE
        INTO HDR
    END-STRING
    MOVE SPACES TO RESP
    MOVE 0 TO RESP-LEN
    MOVE FUNCTION LENGTH(FUNCTION TRIM(HDR TRAILING)) TO HDR-LEN
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > HDR-LEN
        ADD 1 TO RESP-LEN
        MOVE HDR(WS-I:1) TO RESP(RESP-LEN:1)
    END-PERFORM
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > BODY-LEN
        ADD 1 TO RESP-LEN
        MOVE BODY(WS-I:1) TO RESP(RESP-LEN:1)
    END-PERFORM
    CALL "carolina_send" USING WS-CLIENT RESP RESP-LEN WS-SENT.

END PROGRAM CAROLINA-SERVER.
